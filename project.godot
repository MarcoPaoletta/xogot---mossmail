[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_jitter_fix=0
3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

renderer/rendering_method="mobile"
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/use_debanding=true
scaling_3d/scale=0.85
mesh_lod/lod_change/threshold_pixels=0

[shader_globals]

forest_grass_albedo={
"type": "sampler2D",
"value": "res://assets/textures/Grass005/Grass005_1K-PNG_Color.png"
}
forest_grass_normal={
"type": "sampler2D",
"value": "res://assets/textures/Grass005/Grass005_1K-PNG_NormalGL.png"
}
forest_dirt_albedo={
"type": "sampler2D",
"value": "res://assets/textures/Ground111/Ground111_1K-PNG_Color.png"
}
forest_dirt_normal={
"type": "sampler2D",
"value": "res://assets/textures/Ground111/Ground111_1K-PNG_NormalGL.png"
}

